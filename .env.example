# Copy to .env and fill in real values. Never commit real values.
# Placeholders only — agents must not invent credentials.

ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://twin:twin@localhost:5432/twin
REDIS_URL=redis://localhost:6379/0

BLOB_ENDPOINT=http://localhost:9000
BLOB_ACCESS_KEY=
BLOB_SECRET_KEY=

# External providers (left empty; wire per-provider clients before use)
STT_API_KEY=
LLM_API_KEY=

# HMAC secret for outbound webhook signatures
WEBHOOK_SIGNING_SECRET=

# Browser layer
BROWSER_ENGINE=patchright
BROWSER_PROFILE_DIR=~/.config/twin-profile
BROWSER_HEADED=true
BOT_DISPLAY_NAME=Fakery Guest
BOT_LOCALE=id-ID
BOT_TIMEZONE=Asia/Jakarta
MEETING_MAX_MINUTES=45
RECORD_AUDIO=true
BLOB_BUCKET=fakery
