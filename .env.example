# Copy to .env and fill in real values. Never commit real values.
# Placeholders only — agents must not invent credentials.

ENV=dev
LOG_LEVEL=INFO
TENANT=default
API_KEY=
RETENTION_DAYS=30
RETENTION_DRY_RUN=true

DATABASE_URL=postgresql+asyncpg://twin:twin@localhost:5432/twin
REDIS_URL=redis://localhost:6379/0

BLOB_ENDPOINT=http://localhost:9000
BLOB_ACCESS_KEY=
BLOB_SECRET_KEY=

# External providers (STT wired for M2; LLM arrives with notes in M3)
STT_API_KEY=
STT_PROVIDER=deepgram
STT_DIARIZE=true
STT_LANGUAGE=en
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# HMAC secret for outbound webhook signatures
WEBHOOK_SIGNING_SECRET=

# Browser layer (CloakBrowser stealth Chromium; key only needed for Pro scale)
CLOAKBROWSER_LICENSE_KEY=
BROWSER_PROFILE_DIR=~/.config/twin-profile
BROWSER_GUEST_PROFILE_DIR=~/.config/twin-guest-profile
BROWSER_HEADED=true
BOT_DISPLAY_NAME=Fakery Guest
BOT_RUNTIME=process
BOT_IMAGE=fakery:dev
POD_NAMESPACE=fakery
BOT_LOCALE=id-ID
BOT_TIMEZONE=Asia/Jakarta
MEETING_MAX_MINUTES=45
RECORD_AUDIO=true
BLOB_BUCKET=fakery
PROFILE_ENCRYPTION_KEY=
